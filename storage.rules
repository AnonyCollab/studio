
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Only authenticated users can upload files.
    // Files are stored in a folder structure based on the DM/group ID.
    // e.g., /dms/{dmId}/{userId}/{fileName}
    match /dms/{dmId}/{userId}/{allPaths=**} {
      
      // Check if the user is a participant of the DM/group.
      function isParticipant(database) {
        return get(/databases/$(database)/documents/dms/$(dmId)).data.participants.hasAny([request.auth.uid]);
      }

      // Allow read (download) only if the user is a participant in the conversation.
      allow read: if request.auth != null && isParticipant(database);

      // Allow write (upload, delete) only if the user is a participant and the uploader.
      allow write: if request.auth != null && isParticipant(database) && request.auth.uid == userId;
    }
  }
}
