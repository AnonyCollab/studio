
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for an accepted friend request
    function acceptedFriendRequestExists(user1, user2) {
      return (
        exists(/databases/$(database)/documents/friendRequests/$(user1 + '_' + user2)) &&
        get(/databases/$(database)/documents/friendRequests/$(user1 + '_' + user2)).data.status == 'accepted'
      ) || (
        exists(/databases/$(database)/documents/friendRequests/$(user2 + '_' + user1)) &&
        get(/databases/$(database)/documents/friendRequests/$(user2 + '_' + user1)).data.status == 'accepted'
      );
    }

    // Users can be read by anyone. Writes are restricted to the owner of the document.
    match /users/{userId} {
      allow get: if request.auth != null;
      // Allow a query if it's asking for a specific list of UIDs (up to 10)
      allow list: if request.auth != null && (
          (request.query.limit <= 10 && request.query.get("where") == null) || // for search
          (request.query.where[0][2] in request.auth.token.friends) // for getting friends, not yet implemented
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Friend requests can be created by the sender, read by sender/receiver, and updated by the receiver.
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow update: if request.auth != null && request.auth.uid == resource.data.receiverId;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
    }
    
    // Rules for Direct Messages
    match /dms/{dmId} {
        allow get: if request.auth != null && request.auth.uid in resource.data.participants;
        allow list: if request.auth != null && request.query.where.participants.hasAny([request.auth.uid]);
        allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
        allow update: if request.auth != null && request.auth.uid in resource.data.participants;
        
        match /messages/{messageId} {
            allow read, list: if request.auth != null && get(/databases/$(database)/documents/dms/$(dmId)).data.participants.hasAny([request.auth.uid]); 
            allow create: if request.auth != null 
                && get(/databases/$(database)/documents/dms/$(dmId)).data.participants.hasAny([request.auth.uid])
                && request.resource.data.senderId == request.auth.uid;
        }
    }
    
    match /servers/{serverId} {
        allow list: if request.auth != null && request.query.where.members.hasAny([request.auth.uid]);
        allow get: if request.auth != null && request.auth.uid in resource.data.members;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
        allow update: if request.auth != null && (
          // Allow owner to update
          request.auth.uid == resource.data.ownerId ||
          // Allow users to add themselves
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
           request.resource.data.members.hasAll(resource.data.members) &&
           request.resource.data.members.size() == resource.data.members.size() + 1 &&
           request.auth.uid in request.resource.data.members) ||
          // Allow users to remove themselves (leave server)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
           resource.data.members.hasAll(request.resource.data.members) &&
           resource.data.members.size() == resource.data.members.size() - 1 &&
           request.auth.uid in resource.data.members &&
           !(request.auth.uid in request.resource.data.members))
        );
        allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
        
        match /channels/{channelId} {
            allow read, list: if request.auth != null && get(/databases/$(database)/documents/servers/$(serverId)).data.members;
            allow create: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId;
        }

        match /messages/{messageId} {
            allow read, list: if request.auth != null && get(/databases/$(database)/documents/servers/$(serverId)).data.members;
            allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.members && request.resource.data.senderId == request.auth.uid;
        }
    }
    
    match /news/{articleId} {
      allow list: if true;
      allow get: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
    
    match /projects/{projectId} {
      // Allow any authenticated user to read projects.
      allow list, get: if true;

      // Allow any authenticated user to create a project.
      allow create: if request.auth != null;
      
      // Only allow the owner of the project to update or delete it.
      // Allow any authenticated user to join a project (update the 'members' array).
      allow update: if request.auth != null && (
        // Owner can update everything
        request.auth.uid == resource.data.owner.uid ||
        // Any user can add themselves to the members list
        (
          request.resource.data.diff(resource.data).affectedKeys().hasAll(['members', 'totalMembers']) &&
          request.resource.data.members.hasAll(resource.data.members) && // new list contains all old members
          request.resource.data.members.size() == resource.data.members.size() + 1 && // only one new member
          request.resource.data.members[resource.data.members.size()] == request.auth.uid && // the new member is the user
          request.resource.data.totalMembers == resource.data.totalMembers + 1 // totalMembers is incremented
        )
      );

      // Only allow the owner to delete.
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner.uid;

      // Rules for the members subcollection
      match /members/{userId} {
        // Allow project members to list and read other members' info.
        allow list, get: if request.auth != null && get(/databases/$(database)/documents/projects/$(projectId)).data.members.hasAny([request.auth.uid]);
        
        // Allow a user to join a project (create their own member doc)
        // or the project owner to add members.
        allow create: if request.auth != null && 
          (request.auth.uid == userId || request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.owner.uid);

        // Allow owner to update roles, or user to update their own info.
        allow update: if request.auth != null && 
          (request.auth.uid == userId || request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.owner.uid);
          
        // Allow user to leave or owner to remove.
        allow delete: if request.auth != null && 
          (request.auth.uid == userId || request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.owner.uid);
      }
      
      // Rules for the resources subcollection
      match /resources/{resourceId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/projects/$(projectId)).data.members.hasAny([request.auth.uid]);
      }
      
      // Rules for the tasks subcollection
      match /tasks/{taskId} {
        allow read, write: if request.auth != null;

        match /comments/{commentId} {
            allow read, write: if request.auth != null;
        }
      }
    }

    match /posts/{postId} {
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.author.uid;

      match /comments/{commentId} {
        allow get: if true;
        allow list: if true;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if request.auth != null && (request.auth.uid == resource.data.authorId || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.author.uid);

        match /replies/{replyId} {
          allow read, list: if true;
          allow create, update: if request.auth != null;
          allow delete: if request.auth != null;
        }
      }
    }
  }
}
