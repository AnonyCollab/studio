rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Allow authenticated users to upload files up to 5MB.
    // Access control is managed through Firestore, which stores the download URLs.
    match /projects/{projectId}/resources/{allPaths=**} {
        allow read; // Allows public read access to files via URL
        allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }

    // Legacy rules for DMs, can be kept or updated.
    match /dms/{dmId}/{userId}/{allPaths=**} {
      function isParticipant(database) {
        return get(/databases/$(database)/documents/dms/$(dmId)).data.participants.hasAny([request.auth.uid]);
      }

      allow read: if request.auth != null && isParticipant(database);
      allow write: if request.auth != null && isParticipant(database) && request.auth.uid == userId;
    }
  }
}
